generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  date       DateTime
  totalPrice Float
  supplierId String
  createdAt  DateTime       @default(now())
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]
  inventoryTransactions InventoryTransaction[]
}

model PurchaseItem {
  id              String         @id @default(cuid())
  purchaseId      String
  itemName        String
  orderUnits      String?
  quantity        Float
  pricePerUnit    Float
  totalPrice      Float
  purchase        Purchase       @relation(fields: [purchaseId], references: [id])
  rawIngredientId String?
  rawIngredient   RawIngredient? @relation(fields: [rawIngredientId], references: [id])
}

enum MeasurementUnit {
  KG
  L
  EACH
  BUNCH
  HEAD
}

model RawIngredient {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  currentQuantity       Float
  canonicalUnit         MeasurementUnit        @default(KG)
  createdAt             DateTime               @default(now())
  recipeIngredients     RecipeIngredient[]
  purchaseItems         PurchaseItem[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryTransactions InventoryTransaction[]
  transferItems         InventoryTransferItem[]
}

model Recipe {
  id                 String              @id @default(cuid())
  name               String              @unique
  servings           Float
  createdAt          DateTime            @default(now())
  finishedInventory  FinishedInventory?
  posProductMappings POSProductMapping[]
  productionBatches  ProductionBatch[]
  ingredients        RecipeIngredient[]
  sales              Sale[]
  salesImports       SalesImport[]
  orders             Order[]
}

model RecipeIngredient {
    id              String        @id @default(cuid())
    recipeId        String
    rawIngredientId String
    quantity        Float
    rawIngredient   RawIngredient @relation(fields: [rawIngredientId], references: [id])
    recipe          Recipe        @relation(fields: [recipeId], references: [id])
  
    @@unique([recipeId, rawIngredientId])
}

model ProductionBatch {
  id               String   @id @default(cuid())
  recipeId         String
  quantityProduced Float
  createdAt        DateTime @default(now())
  recipe           Recipe   @relation(fields: [recipeId], references: [id])
  orderId          String?
  order            Order? @relation(fields: [orderId], references: [id])
  inventoryTransactions InventoryTransaction[]
}

model FinishedInventory {
  id                String   @id @default(cuid())
  recipeId          String   @unique
  quantityAvailable Float
  updatedAt         DateTime @updatedAt
  recipe            Recipe   @relation(fields: [recipeId], references: [id])
}

model Sale {
  id           String   @id @default(cuid())
  recipeId     String
  quantitySold Float
  createdAt    DateTime @default(now())
  recipe       Recipe   @relation(fields: [recipeId], references: [id])
}

model POSProductMapping {
  id             String   @id @default(cuid())
  posProductName String   @unique
  recipeId       String
  createdAt      DateTime @default(now())
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
}

model SalesImport {
  id             String   @id @default(cuid())
  posProductName String
  quantitySold   Float
  recipeId       String
  importedAt     DateTime @default(now())
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  passwordHash  String
  name      String
  roleId      Int
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

enum OrderStatus {
  CREATED
  PENDING
  DONE
  DELIVERY
  FINISHED
}

model Order {
  id        String      @id @default(cuid())
  product   String?
  quantity  Int
  status    OrderStatus @default(CREATED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  statusLogs OrderStatusLog[]
  recipeId  String?
  recipe    Recipe? @relation(fields: [recipeId], references: [id])
  productionBatches ProductionBatch[]
  location   Location?
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  previousStatus  OrderStatus?
  newStatus       OrderStatus
  createdAt       DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


model InventoryAdjustment {
  id                String   @id @default(cuid())
  rawIngredientId   String
  previousQuantity  Float
  newQuantity       Float
  reason            String?
  createdAt         DateTime @default(now())

  rawIngredient RawIngredient @relation(fields: [rawIngredientId], references: [id], onDelete: Cascade)
}

enum InventoryTransactionType {
  PURCHASE
  PRODUCTION
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryTransaction {
  id                  String                   @id @default(cuid())
  rawIngredientId     String
  type                InventoryTransactionType
  quantityChange      Float
  previousQuantity    Float
  newQuantity         Float
  reason              String?
  purchaseId          String?
  productionBatchId   String?
  inventoryTransferId String?
  createdAt           DateTime                 @default(now())

  rawIngredient       RawIngredient            @relation(fields: [rawIngredientId], references: [id])
  purchase            Purchase?                @relation(fields: [purchaseId], references: [id])
  productionBatch     ProductionBatch?         @relation(fields: [productionBatchId], references: [id])
  inventoryTransfer   InventoryTransfer?        @relation(fields: [inventoryTransferId], references: [id])
}

enum Location {
  ECHO_KITCHEN
  DEE_PLACE
  ECHO_POKER
  ECHO_EVENTS
}

model InventoryTransfer {
  id                  String                  @id @default(cuid())
  sourceLocation      Location
  destinationLocation Location
  createdAt           DateTime                @default(now())
  items               InventoryTransferItem[]
  inventoryTransactions InventoryTransaction[]
}

model InventoryTransferItem {
  id              String            @id @default(cuid())
  transferId      String
  rawIngredientId String
  quantity        Float

  transfer        InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  rawIngredient   RawIngredient     @relation(fields: [rawIngredientId], references: [id])
}